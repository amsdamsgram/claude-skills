{
  "name": "cloudflare-deploy-mcp",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,

  "vars": {
    // The hostname this Worker answers on. Deploy once, read the workers.dev
    // hostname it prints, put it here, deploy again. A custom domain works too
    // but is not required.
    "PUBLIC_HOST": "cloudflare-deploy-mcp.YOUR-SUBDOMAIN.workers.dev"
  },

  "kv_namespaces": [
    { "binding": "PAGES", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]

  // Secrets are set with `wrangler secret put`, never in this file:
  //   CLOUDFLARE_API_TOKEN   Account scope: Access: Apps and Policies: Edit
  //   CLOUDFLARE_ACCOUNT_ID
  //   MCP_SHARED_SECRET      also set as the portal's upstream bearer token
}
